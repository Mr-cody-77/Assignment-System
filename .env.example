# ============================================================
# Assignment System — Environment Configuration Template
# Copy this file to .env and fill in the values
# ============================================================

# Django
SECRET_KEY=django-insecure-change-me-in-production-use-random-50-chars
DEBUG=False
ALLOWED_HOSTS=*

# PostgreSQL (point to the Teacher's machine IP in student nodes)
DB_NAME=assignment_system
DB_USER=assignment_admin
DB_PASSWORD=PostgreSQL@pass77
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Node Configuration
NODE_PORT=8000
WORKER_LIMIT=5
SAFE_CPU_THRESHOLD=0.85
SAFE_MEMORY_THRESHOLD=0.85

# Execution Limits
DEFAULT_TIMEOUT_SECONDS=10
DEFAULT_MEMORY_LIMIT_MB=256

# Frontend (React build served from Django)
REACT_APP_API_BASE_URL=http://localhost:8000
